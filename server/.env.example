# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# Jangan pernah commit file ".env" (sudah ada di .gitignore).

NODE_ENV=development
PORT=4000

# --- Database (Supabase PostgreSQL) ---
# Ambil dari Supabase Dashboard -> tombol "Connect", lalu ganti [YOUR-PASSWORD].
# Pilih jenisnya sesuai tempat backend berjalan:
#   - Server/VPS yang menyala terus  -> Direct connection (butuh IPv6 atau add-on
#     IPv4), atau Session pooler (port 5432, IPv4) bila jaringan hanya IPv4.
#   - Serverless / batas koneksi ketat -> Transaction pooler (port 6543) dan isi
#     DB_POOL_MAX=1.
#   - "npm run db:migrate" sebaiknya lewat Direct connection atau Session pooler.
# PENTING: password yang mengandung karakter khusus (#, &, ?, @, /, spasi) harus
# di-percent-encode di dalam URL (mis. # -> %23). JANGAN menambahkan ?sslmode=...
# ke URL — SSL diatur lewat DB_SSL / DB_SSL_CA di bawah.
DATABASE_URL=postgresql://postgres:ganti_password@db.PROJECT-REF.supabase.co:5432/postgres
# Batas koneksi di pool aplikasi ini (bukan di pooler Supabase). Default 10.
DB_POOL_MAX=10
# true = SSL (wajib untuk Supabase). false = hanya untuk PostgreSQL lokal tanpa SSL.
DB_SSL=true
# Opsional: path (relatif terhadap folder server/) ke Root Certificate dari Supabase
# Dashboard -> Database Settings -> SSL Configuration. Diisi = server diverifikasi
# penuh; kosong = terenkripsi tanpa verifikasi server.
# DB_SSL_CA=certs/supabase-root.crt

# --- Supabase Storage (foto publik & dokumen PPDB) ---
# Ambil dari Supabase Dashboard -> Project Settings -> API. SUPABASE_URL
# BUKAN connection string database, formatnya https://PROJECT-REF.supabase.co
SUPABASE_URL=https://PROJECT-REF.supabase.co
# service_role key (BUKAN anon key) — rahasia setara akses admin penuh,
# JANGAN PERNAH dikirim ke frontend/browser atau dipakai di kode admin/root.
SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_service_role_key_dari_dashboard
# Buat dulu kedua bucket ini di Supabase Dashboard -> Storage sebelum
# menjalankan server:
#   - photos          -> Public bucket
#   - ppdb-documents   -> Private bucket
PHOTO_BUCKET=photos
PPDB_BUCKET=ppdb-documents

# --- Autentikasi ---
# String acak & panjang, minimal 16 karakter. Contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak
JWT_EXPIRES_IN=12h

# Token login untuk akun pengguna publik (calon siswa/orang tua yang
# mendaftar PPDB) — WAJIB BERBEDA dari JWT_SECRET di atas. Contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_JWT_SECRET=ganti_dengan_string_rahasia_lain_yang_panjang_dan_acak
USER_JWT_EXPIRES_IN=7d

# --- Email (Nodemailer) ---
# Dipakai untuk mengirim kode verifikasi akun & notifikasi status PPDB.
# Contoh konfigurasi Gmail (butuh "App Password", bukan password akun biasa
# — aktifkan di myaccount.google.com/apppasswords setelah 2FA menyala):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat@gmail.com
SMTP_PASSWORD=ganti_dengan_app_password_16_karakter
SMTP_FROM="SMA Bina Taruna <alamat@gmail.com>"

# --- CORS ---
# Alamat tempat situs company profile (React) berjalan.
# Bisa berisi beberapa alamat dipisah koma, mis: http://localhost:5173,https://smabinataruna.sch.id
FRONTEND_ORIGIN=http://localhost:5173

# --- Dipakai HANYA oleh "npm run db:seed-admin" (opsional) ---
# ADMIN_EMAIL=admin@smabinataruna.sch.id
# ADMIN_PASSWORD=GantiSegera#2026
# ADMIN_NAME=Administrator

# --- Modul PPDB ---
# Kunci enkripsi kolom NIK pendaftar PPDB. WAJIB base64 yang mem-decode
# menjadi TEPAT 32 byte. Contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PENTING — BACKUP NILAI INI seaman JWT_SECRET/password database:
# jika hilang atau berubah, SELURUH NIK pendaftar yang sudah tersimpan
# tidak akan bisa didekripsi lagi (data hilang permanen, bukan sekadar
# terkunci). Simpan salinannya di tempat terpisah dari server (mis.
# password manager tim), jangan hanya di file .env ini.
ENCRYPTION_KEY=ganti_dengan_hasil_perintah_di_atas

# Batas ukuran per berkas dokumen PPDB, dalam MB.
PPDB_MAX_UPLOAD_MB=2

# Batas ukuran per berkas foto konten publik (mis. foto siswa berprestasi
# di "Wajah-Wajah Juara"), dalam MB.
PHOTO_MAX_UPLOAD_MB=3

# --- Khusus deploy di Vercel (lihat vercel.json) ---
# Set env var ini di Vercel Project Settings -> Environment Variables (bukan
# di file ini). DATABASE_URL WAJIB pakai Transaction pooler Supabase (port
# 6543, bukan 5432) karena tiap invocation serverless adalah koneksi baru:
#   DATABASE_URL=postgresql://...@aws-0-xxxx.pooler.supabase.co:6543/postgres
#   DB_POOL_MAX=1
