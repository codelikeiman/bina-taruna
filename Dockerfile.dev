# Dev-only image untuk situs publik (root). Vite dev server + HMR jalan di
# dalam container, source di-mount dari host (lihat docker-compose.yml)
# supaya perubahan file langsung ke-reload tanpa rebuild image.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
